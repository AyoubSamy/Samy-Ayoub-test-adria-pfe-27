type Query {
    transactions: [Transaction]
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    createTransaction(request: TransactionRequest!): Transaction
    transfer(request: TransferRequest!): Boolean
}

input TransactionRequest {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

input TransferRequest {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
}

type Transaction {
    id: ID
    accountId: ID
    amount: Float
    currency: String
    merchantCategory: String
    country: String
    createdAt: String
}
